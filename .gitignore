# =============================================================================
# 資格情報を含むファイル（絶対にコミットしないこと）
# =============================================================================
# ALPS
services/*/var_www_html/cti_apis/config.php
services/*/agi-bin/alps_config.py
**/config.php
**/config.local.php
**/*_config.py
!**/*.example.php
!**/*_config.example.py

# MOUNTAIN アプリ
.env
.env.*
!.env.sample
!.env.example

# 鍵・証明書
*.pem
*.key
*.p12
*.pfx
id_rsa*
**/keys/

# インフラ定義（社内ホスト名・内部 IP を含むため公開リポジトリには置かない）
infra/

# =============================================================================
# 依存関係・ビルド成果物
# =============================================================================
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =============================================================================
# 実行時に生成されるもの
# =============================================================================
*.log
recordings/
uploads/
*.sqlite
*.sqlite3
*.db

# 音声ファイル（アナウンス・通話録音）
*.wav
*.gsm
*.ulaw

# =============================================================================
# OS / エディタ
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
