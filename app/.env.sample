# MOUNTAIN アプリ 環境変数サンプル
# 本番では強固なパスワードに変更し、Vault 管理としてください（このファイルはコミットしない）。

POSTGRES_USER=mountain
POSTGRES_PASSWORD=mountain
POSTGRES_DB=mountain

# フロント(nginx)を公開するホストポート
WEB_PORT=8080

# API の CORS 許可（本番は同一オリジンのため制限。開発は *）
CORS_ORIGINS=*

# ---- やり取り履歴から共通の Microsoft 365 グループ予定表へ登録 ----
# Entra 認証を構成した環境でのみ有効化。設定・管理者同意は docs/CONFIGURATION.md を参照。
CALENDAR_ENABLED=False
# Teams の背後にある Microsoft 365 グループの Object ID（チャネル ID ではない）
CALENDAR_GROUP_ID=
CALENDAR_NAME=共通カレンダー
# ENTRA_API_CLIENT_ID のアプリで発行したクライアントシークレットの「値」。SPA のものではない。
ENTRA_API_CLIENT_SECRET=

# ---- CTI（電話交換機連携）----
# DF（検証）は simulator。本番で交換機を接続したら pbx に変更し、下の CTI_PBX_* を設定。
CTI_PROVIDER=simulator
# 本番PBX接続情報（pbx のときに使用）
CTI_PBX_HOST=
CTI_PBX_PORT=0
CTI_PBX_USERNAME=
CTI_PBX_SECRET=
# 通話録音の保管場所
CTI_RECORDING_DIR=/var/mountain/recordings

# ---- 入力補助（外部公開APIによる住所・銀行・企業情報の自動入力）----
# 郵便番号→住所（zipcloud）と 銀行・支店（bank.teraren.com）は認証不要のため設定不要。
# 法人番号→企業情報（gBizINFO）だけは無料の利用登録で得るAPIトークンが必要。
# 空欄のままなら「法人番号検索」だけが使えない（住所・銀行の補助は通常どおり使える）。
# トークン取得: https://info.gbiz.go.jp/ で無料登録 → 発行された文字列をここに貼る。
GBIZ_API_TOKEN=

# ---- モックデータの自動初期化（DF・動作確認環境の専用機能）----
# 空欄＝無効（本番は必ず空）。DF だけ true にすると、毎日 MOCK_RESET_AT の時刻に
# その日に登録・編集・削除したデータをすべて消し、同梱の“お手本”モックデータだけの状態へ戻す。
# 管理画面（管理→メンテナンス）から手動でも実行できる。
MOCK_RESET_ENABLED=
# 初期化する時刻（日本時間 JST・HH:MM）。既定は毎日 0:00。
MOCK_RESET_AT=00:00

# ---- 本番導入用の土台データ自動生成（初回アクセス時）----
# True（既定）＝アプリ起動時に、業務の土台（区分マスタ・権限・ロール・着信アナウンス定義・
# システム利用者2件）が無ければ app/baseline.sql から自動生成する（冪等・既にあれば何もしない）。
# これにより本番は「空のデータベースを用意して起動するだけ」で初回アクセス時に土台が整う。
# 無効化したい特別な場合のみ False。
AUTO_PROVISION_ENABLED=True
