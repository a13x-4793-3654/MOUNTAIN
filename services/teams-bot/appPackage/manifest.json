{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "0.2.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "MOUNTAIN",
    "websiteUrl": "https://${{BOT_DOMAIN}}",
    "privacyUrl": "https://${{BOT_DOMAIN}}/privacy",
    "termsOfUseUrl": "https://${{BOT_DOMAIN}}/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "MOUNTAIN Bot",
    "full": "MOUNTAIN Teams Bot"
  },
  "description": {
    "short": "MOUNTAIN の接続確認と個人チャットでの契約検索",
    "full": "Dokploy 上で稼働する MOUNTAIN Teams Bot です。ping、help、テキスト応答と、サインインした本人の権限に基づく個人チャットでの契約検索に対応します。業務データの変更は行いません。契約検索には管理者による API と OAuth 接続の設定が必要です。"
  },
  "accentColor": "#243B53",
  "supportsChannelFeatures": "tier1",
  "bots": [
    {
      "botId": "${{CLIENT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "ping",
              "description": "接続を確認します。"
            },
            {
              "title": "help",
              "description": "利用できるコマンドを表示します。"
            },
            {
              "title": "契約検索",
              "description": "キーワードで契約を検索します。個人チャット・サインイン必須です。"
            },
            {
              "title": "ログアウト",
              "description": "MOUNTAIN 連携からサインアウトします。"
            }
          ]
        },
        {
          "scopes": ["team", "groupChat"],
          "commands": [
            {
              "title": "ping",
              "description": "接続を確認します。"
            },
            {
              "title": "help",
              "description": "利用できるコマンドを表示します。"
            }
          ]
        }
      ]
    }
  ],
  "validDomains": ["${{BOT_DOMAIN}}", "token.botframework.com"]
}
