# Bot runtime: use a dedicated single-tenant Entra application.
# CLIENT_SECRET must be the secret VALUE, not the secret ID.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
PORT=3978

# Optional delegated contract search. Leave both empty to keep it disabled.
# The API must use Entra authentication and belong to TENANT_ID.
MOUNTAIN_API_BASE_URL=
MOUNTAIN_OAUTH_CONNECTION_NAME=

# Teams app package only; not required by the running container.
# BOT_DOMAIN is a hostname without a scheme, port, or path.
# Generate TEAMS_APP_ID once and keep it unchanged for app updates.
BOT_DOMAIN=
TEAMS_APP_ID=
